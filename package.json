{
  "name": "cluely-hermes",
  "version": "1.0.0",
  "description": "Echo — asistente de reuniones para macOS: escucha y transcribe (diarizado por canal), ve tu pantalla y razona con Hermes; overlay indetectable y notas automáticas en Obsidian.",
  "main": "main.js",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "dev": "env -u ELECTRON_RUN_AS_NODE electron . --no-sandbox --disable-gpu",
    "build:mac": "electron-builder --mac",
    "build-and-install": "bash scripts/build-and-install.sh",
    "create-cert": "bash scripts/create-signing-cert.sh",
    "clean": "rm -rf dist/",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": {
    "name": "EstebanCastel",
    "url": "https://github.com/EstebanCastel"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EstebanCastel/cluely-hermes"
  },
  "license": "MIT",
  "dependencies": {
    "@deepgram/sdk": "^3.13.0",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^16.3.1",
    "markdown": "^0.5.0",
    "marked": "^15.0.12",
    "microsoft-cognitiveservices-speech-sdk": "^1.40.0",
    "node-record-lpcm16": "^1.0.1",
    "prismjs": "^1.30.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.echo.app",
    "productName": "Echo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!*.md",
      "!.git/**/*",
      "!.env*",
      "!**/__pycache__/**"
    ],
    "extraFiles": [
      {
        "from": "prompts",
        "to": "prompts"
      }
    ],
    "extraResources": [
      {
        "from": "sidecar",
        "to": "sidecar"
      }
    ],
    "asarUnpack": [
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icons/echo.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Echo escucha el audio para transcribir la conversación.",
        "NSScreenCaptureUsageDescription": "Echo captura la pantalla para que el asistente pueda verla.",
        "LSUIElement": true
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "assets/icons/app-icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/app-icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "dmg": {
      "title": "Echo",
      "backgroundColor": "#000000",
      "window": {
        "width": 600,
        "height": 400
      }
    }
  }
}
