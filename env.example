# Echo — variables de entorno.
# En tiempo de ejecución Echo lee la API key de Deepgram desde ~/.Echo/.env
# (puedes configurarla también desde Ajustes → General → Audio).

# Deepgram (transcripción en vivo). Consigue tu key en https://console.deepgram.com
DEEPGRAM_API_KEY=tu_api_key_de_deepgram

# El cerebro (Hermes) gestiona sus propias credenciales de LLM en ~/.hermes/
# (config.yaml y ~/.hermes/.env). Echo no necesita claves de LLM aquí.
